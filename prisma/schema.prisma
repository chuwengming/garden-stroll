// Prisma schema — Garden Stroll LINE 預約系統
// 依 docs/form-schema.yaml（terminology: booking）與 docs/invariants.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ProcessedEvent {
  id               Int      @id @default(autoincrement())
  webhookEventId   String   @unique
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("processed_events")
}

model User {
  id           Int      @id @default(autoincrement())
  lineUserId   String   @unique @map("line_user_id")
  displayName  String?  @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bookings     Booking[]

  @@map("users")
}

model Booking {
  id            Int      @id @default(autoincrement())
  lineUserId    String   @map("line_user_id")
  name          String
  phone         String
  bookingDate   DateTime @map("booking_date")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  items         Json     @map("items")
  people        Int      @default(1)
  notes         String?
  status        String   @default("confirmed")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User?    @relation(fields: [lineUserId], references: [lineUserId])

  @@index([bookingDate, status])
  @@map("bookings")
}

model DesignerLeave {
  id        Int      @id @default(autoincrement())
  leaveDate DateTime @map("leave_date")
  startTime String?  @map("start_time")   // null = 整天請假
  endTime   String?  @map("end_time")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leaveDate])
  @@map("designer_leaves")
}

model Conversation {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  smalltalkCount Int    @default(0) @map("smalltalk_count")
  closedAt     DateTime? @map("closed_at")
  flowJson     Json?    @map("flow_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("conversations")
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  conversationKey String  @map("conversation_key")
  role          String
  content       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([conversationKey, createdAt])
  @@map("chat_messages")
}
